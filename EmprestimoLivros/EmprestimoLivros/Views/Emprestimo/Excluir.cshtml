@model EmprestimosModel

@{
    ViewData["title"] = "Excluir";
}

<div class="container bg-dark p-5 rounded-5">
    <div class="mb-5 text-center">
        <h1 class="text-light">@ViewData["title"] Empréstimos</h1>
    </div>

    <form method="post" asp-controller="Emprestimo" asp-action="Excluir" class="w-100">
        <h2 class="text-light text-center" >Desejas Remover ese Arquivo!</h2>
        <input type="hidden" asp-for="Id" />

        <div class="mb-3 text-light">
            <label for="Recebedor" class="form-label">Recebedor: </label>
            <input type="text" asp-for="Recebedor" class="form-control text-light" id="Recebedor" placeholder="Quem está a receber o livro" disabled">
            <span class="text-danger" asp-validation-for="Recebedor"></span>
        </div>


        <div class="mb-3 text-light">
            <label for="Fornecedor" class="form-label">Fornecedor: </label>
            <input type="text" asp-for="Fornecedor" class="form-control text-light" id="Fornecedor" placeholder="Quem está Emprestando o livro" disabled>
            <span class="text-danger" asp-validation-for="Fornecedor"></span>
        </div>

        <div class="mb-3 text-light">
            <label for="Livro" class="form-label">Livro</label>
            <input type="text" asp-for="LivroEmprestado" class="form-control text-light" id="Livro" placeholder="Nome do Livro Empréstado" disabled>
            <span class="text-danger" asp-validation-for="LivroEmprestado"></span>
        </div>

        <div class="d-flex gap-5">
            <button type="submit" class="btn w-50 bg-danger">Excluir</button>
            <a class="btn btn-primary w-50" asp-controller="Emprestimo" asp-action="Index">Voltar</a>
        </div>
    </form>
</div>